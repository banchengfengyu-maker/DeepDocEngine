<Window x:Class="DocSentinel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepDocEngine — 文档内容深度搜索工具 (全格式 / DWG / 图片与内嵌图OCR)"
        Width="1360" Height="840" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Daemon Status & Global Stats Bar -->
        <Border Grid.Row="0" Background="#0F172A" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="DeepDocEngine" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border x:Name="StatusBadge" Background="#DC2626" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadgeText" Text="未连接" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="StatsText" Text="文档: 0 | 去重块: 0 | 加密: 0 | 失败: 0" Foreground="#94A3B8" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnDeepDeletePicker" Content="深度删除文件..." Click="BtnDeepDeletePicker_Click" Margin="0,0,8,0"
                            Background="#991B1B" Foreground="#FEF2F2" BorderBrush="#B91C1C" ToolTip="安全慢速覆写并从硬盘与索引库彻底粉碎指定文件（不易触发杀软拦截）" />
                    <Button x:Name="BtnConnect" Content="连接 / 启动引擎" Click="BtnConnect_Click" Margin="0,0,8,0" />
                    <Button x:Name="BtnRefreshStats" Content="刷新统计" Click="BtnRefreshStats_Click" Margin="0,0,8,0" />
                    <Button x:Name="BtnClearIndex" Content="清空索引" Click="BtnClearIndex_Click" Background="#7F1D1D" Foreground="#FEE2E2" BorderBrush="#991B1B" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Sources + Saved Deep Queries -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="335" MinHeight="260" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- Data Sources & Fast Filter Panel -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="1. 搜索范围与解析选项（支持直接拖入文件夹/文件）" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="添加文件夹" Click="BtnAddFolder_Click" Margin="0,0,4,4" />
                                <Button Content="添加文件" Click="BtnAddFiles_Click" Margin="0,0,4,4" />
                                <Button Content="固定硬盘" Click="BtnAddFixedDrives_Click" Margin="0,0,4,4" ToolTip="添加本机全部固定盘根目录（优先启用 NTFS USN 秒级扫描）" />
                                <Button Content="U盘" Click="BtnAddUsbDrives_Click" Margin="0,0,4,4" ToolTip="添加当前插入的可移动磁盘" />
                                <Button Content="移除" Click="BtnRemoveRoot_Click" Margin="0,0,0,4" />
                            </WrapPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="仅扫后缀:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" Margin="0,0,4,0" />
                                <TextBox x:Name="TxtIncludeExts" Grid.Column="1" FontSize="11" Padding="4,2" ToolTip="留空扫全部支持文档（Office/PDF/WPS/DWG/图片/邮件/压缩包等），可填 pdf,docx,dwg,png" />
                                <TextBlock Grid.Column="2" Text="密码:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" Margin="6,0,4,0" />
                                <TextBox x:Name="TxtPassword" Grid.Column="3" FontSize="11" Padding="4,2" ToolTip="可选解压/PDF/Access通用密码" />
                            </Grid>
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="ChkEnableOcr" Content="图片与内嵌图OCR" IsChecked="True" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,2" />
                                <CheckBox x:Name="ChkSkipTemp" Content="忽略~$临时/系统目录" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,2" FontSize="11" />
                                <CheckBox x:Name="ChkIdleIndex" Content="闲时自动增量(3分)" IsChecked="False" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="11"
                                          ToolTip="连续 3 分钟无键鼠操作且存在目录时，自动低优先级增量更新索引（无后台实时文件监控驻留）" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="BtnStartScan" Style="{StaticResource PrimaryButton}" Content="增量索引" Click="BtnStartScan_Click" Margin="0,0,6,4"
                                        ToolTip="跳过未变更文件并利用 NTFS USN 日志快速增量更新索引" />
                                <Button x:Name="BtnRebuildScan" Content="重建索引" Click="BtnRebuildScan_Click" Margin="0,0,6,4"
                                        ToolTip="清空当前文档库后全量重建索引（自动保留图片 OCR 缓存）" />
                                <Button x:Name="BtnDirectSearch" Content="临时直搜(不落库)" Click="BtnDirectSearch_Click" Margin="0,0,6,4"
                                        ToolTip="不写入本地索引库，直接按右侧搜索框关键词并发直搜所选目录" />
                                <Button x:Name="BtnCancelScan" Content="停止" Click="BtnCancelScan_Click" IsEnabled="False" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="RootsList" AllowDrop="True" DragOver="RootsList_DragOver" Drop="RootsList_Drop"
                                 BorderBrush="#E2E8F0" Background="#F8FAFC" FontSize="12" />
                    </DockPanel>
                </Border>

                <!-- Saved Deep Search Expressions Panel -->
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="2. 常用高级检索式收藏（双击立即检索）" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                            <TextBlock Text="支持: NEAR(词1,词2,15) ONEAR SAMELINE &amp; | ! &quot;短语&quot; re:/正则/ scope:ocr(...)" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="+ 收藏检索式" Click="BtnAddRule_Click" />
                            <Button Content="- 删除" Click="BtnDeleteRule_Click" Margin="4,0,0,0" />
                            <Button x:Name="BtnEvalRules" Style="{StaticResource PrimaryButton}" Content="批量运行所选" Click="BtnEvalRules_Click" Margin="6,0,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  MouseDoubleClick="RulesGrid_MouseDoubleClick"
                                  BorderBrush="#E2E8F0" Background="#FFFFFF" RowHeight="26" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="105" />
                                <DataGridTextColumn Header="高级搜索表达式" Binding="{Binding Expression}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Column: Search + Virtualized Results + Provenance Preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="280" MinHeight="160" />
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Grid.Column="0" Padding="8,6" FontSize="13" VerticalContentAlignment="Center"
                                     KeyDown="TxtSearch_KeyDown" ToolTip="支持空格分隔多个关键词（可在右侧切换全部命中/任一命中）；勾选[表达式]可用 NEAR(A,B,20) / &amp; / | / scope:ocr(...)" />
                            <ComboBox x:Name="CmbMultiKeyword" Grid.Column="1" Margin="6,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center" FontSize="11"
                                      ToolTip="空格分隔多个关键词时的匹配逻辑">
                                <ComboBoxItem Content="多词: 全部包含(AND)" Tag="all" />
                                <ComboBoxItem Content="多词: 任一命中(OR)" Tag="any" />
                            </ComboBox>
                            <ComboBox x:Name="CmbScopeFilter" Grid.Column="2" Margin="6,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="全部字段" Tag="" />
                                <ComboBoxItem Content="文件名" Tag="FileName" />
                                <ComboBoxItem Content="首尾行" Tag="HeadTail" />
                                <ComboBoxItem Content="正文" Tag="Body" />
                                <ComboBoxItem Content="OCR/内嵌图" Tag="Ocr" />
                                <ComboBoxItem Content="表格" Tag="Table" />
                                <ComboBoxItem Content="元数据" Tag="Metadata" />
                            </ComboBox>
                            <CheckBox x:Name="ChkRegexSearch" Grid.Column="3" Content="正则" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <CheckBox x:Name="ChkExprMode" Grid.Column="4" Content="表达式(NEAR)" VerticalAlignment="Center" Margin="8,0,8,0" ToolTip="勾选后使用高精度布尔与邻近检索引擎: NEAR(A,B,20) / ONEAR / SAMELINE / scope:ocr(...)" />
                            <Button x:Name="BtnSearch" Grid.Column="5" Style="{StaticResource PrimaryButton}" Content="立即搜索" Click="BtnSearch_Click" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="文件类型:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" Margin="0,0,4,0" />
                            <ComboBox x:Name="CmbTypePreset" Grid.Column="1" SelectedIndex="0" SelectionChanged="CmbTypePreset_SelectionChanged" FontSize="11" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="全部格式" Tag="" />
                                <ComboBoxItem Content="文档 (Word/PDF/WPS/OFD)" Tag="docx,doc,wps,pdf,ofd,uof,txt,md,rtf" />
                                <ComboBoxItem Content="表格 (Excel/ET/CSV)" Tag="xlsx,xls,xlsm,et,ods,csv" />
                                <ComboBoxItem Content="演示 (PPT/WPS演示)" Tag="pptx,ppt,dps,odp" />
                                <ComboBoxItem Content="CAD工程图纸 (DWG/DXF)" Tag="dwg,dxf" />
                                <ComboBoxItem Content="图片 (PNG/JPG/TIF等)" Tag="png,jpg,jpeg,bmp,tif,tiff,gif,webp" />
                                <ComboBoxItem Content="压缩包 (ZIP/RAR/7Z等)" Tag="zip,rar,7z,tar,gz,iso,cab" />
                                <ComboBoxItem Content="邮件 (EML/MSG/PST)" Tag="eml,mbox,msg,pst,ost" />
                            </ComboBox>
                            <TextBox x:Name="TxtExtFilter" Grid.Column="2" Margin="6,0,0,0" Padding="6,4" FontSize="11"
                                     VerticalContentAlignment="Center" ToolTip="支持逗号分隔多后缀过滤，如 pdf,docx,dwg" />
                            <TextBlock Grid.Column="3" Text="指定目录:" VerticalAlignment="Center" FontSize="11" Foreground="#475569" Margin="10,0,4,0" />
                            <TextBox x:Name="TxtDirFilter" Grid.Column="4" Padding="6,4" FontSize="11" VerticalContentAlignment="Center"
                                     ToolTip="留空表示全局搜索；填写或选择目录后仅在该目录及子目录下检索（同样支持表达式模式）" />
                            <Button Grid.Column="5" Content="选目录..." Click="BtnPickDirFilter_Click" Margin="4,0,0,0" Padding="8,3" FontSize="11" />
                            <Button Grid.Column="6" Content="清空" Click="BtnClearDirFilter_Click" Margin="4,0,0,0" Padding="8,3" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Results Virtualized DataGrid -->
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6">
                    <DockPanel>
                        <TextBlock x:Name="ResultsHeader" DockPanel.Dock="Top" Text="搜索命中文档列表（单击预览定位，双击直接打开原文件）"
                                   FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="4,2,0,6" />
                        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionMode="Extended" SelectionChanged="ResultsGrid_SelectionChanged"
                                  MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="26" FontSize="12">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开文件" Click="MenuOpenFile_Click" />
                                    <MenuItem Header="打开文件所在目录" Click="MenuOpenFolder_Click" />
                                    <MenuItem Header="复制完整路径" Click="MenuCopyPath_Click" />
                                    <Separator />
                                    <MenuItem Header="限定搜索到该文件所在目录" Click="MenuFilterByRowFolder_Click" />
                                    <Separator />
                                    <MenuItem Header="深度删除选中文件（防杀软慢速擦除）" Click="MenuDeepDeleteSelected_Click" Foreground="#DC2626" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="方式" Binding="{Binding KindBadge}" Width="55" />
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="165" />
                                <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="55" />
                                <DataGridTextColumn Header="相关度 / 命中" Binding="{Binding RuleOrScore}" Width="125" />
                                <DataGridTextColumn Header="命中来源（正文/OCR/DWG等）" Binding="{Binding LocationLabel}" Width="165" />
                                <DataGridTextColumn Header="命中上下文片段" Binding="{Binding Snippet}" Width="*" />
                                <DataGridTextColumn Header="文档路径" Binding="{Binding VirtualPath}" Width="210" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Highlighted Provenance Preview Pane -->
                <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnPrevHit" Content="◀ 上一处" Click="BtnPrevHit_Click" Padding="6,2" FontSize="11" />
                                <TextBlock x:Name="HitNavText" Text="0 / 0" VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#475569" />
                                <Button x:Name="BtnNextHit" Content="下一处 ▶" Click="BtnNextHit_Click" Padding="6,2" FontSize="11" Margin="0,0,8,0" />
                                <Button Content="打开文件" Click="MenuOpenFile_Click" Padding="8,2" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="打开所在目录" Click="MenuOpenFolder_Click" Padding="8,2" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="深度删除" Click="MenuDeepDeleteSelected_Click" Padding="8,2" FontSize="11" Foreground="#B91C1C" BorderBrush="#FCA5A5" Background="#FEF2F2" />
                            </StackPanel>
                            <TextBlock x:Name="PreviewHeader" Text="原文与 OCR 分段高亮预览"
                                       FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <RichTextBox x:Name="PreviewBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" BorderBrush="#E2E8F0" Background="#FAFAFA"
                                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Progress Footer -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="12,6" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar x:Name="ScanProgressBar" DockPanel.Dock="Right" Width="200" Height="14" IsIndeterminate="False" Value="0" Maximum="100" />
                <TextBlock x:Name="FooterStatusText" Text="就绪" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
