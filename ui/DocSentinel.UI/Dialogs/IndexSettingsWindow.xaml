<Window x:Class="DocSentinel.UI.Dialogs.IndexSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="索引目录与扫描设置"
        Width="640" Height="500" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="配置需要建立全文索引与深度检索的本地磁盘/文件夹范围（支持直接拖入目录或文件）："
                       FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" />
            <WrapPanel Margin="0,8,0,0">
                <Button Content="添加文件夹..." Click="BtnAddFolder_Click" Margin="0,0,6,4" />
                <Button Content="添加文件..." Click="BtnAddFiles_Click" Margin="0,0,6,4" />
                <Button Content="添加全部固定硬盘" Click="BtnAddFixedDrives_Click" Margin="0,0,6,4"
                        ToolTip="扫描本机所有固定盘（支持 NTFS USN 秒级增量对比）" />
                <Button Content="添加可移动磁盘(U盘)" Click="BtnAddUsbDrives_Click" Margin="0,0,6,4" />
                <Button Content="移除选中" Click="BtnRemoveRoot_Click" Margin="0,0,0,4" />
            </WrapPanel>
        </StackPanel>

        <ListBox x:Name="RootsList" Grid.Row="1" AllowDrop="True"
                 DragOver="RootsList_DragOver" Drop="RootsList_Drop"
                 BorderBrush="#CBD5E1" Background="#FFFFFF" FontSize="12.5"
                 SelectionMode="Extended" />

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="仅扫描后缀:" VerticalAlignment="Center" FontSize="12" Foreground="#475569" Margin="0,0,6,0" />
                    <TextBox x:Name="TxtIncludeExts" Grid.Column="1" Padding="6,4" FontSize="12"
                             ToolTip="留空扫描全部支持文档（Office/PDF/WPS/DWG/图片/邮件/压缩包等），多个请用逗号分隔，例如 pdf,docx,dwg" />
                    <TextBlock Grid.Column="2" Text="解压/文档通用密码:" VerticalAlignment="Center" FontSize="12" Foreground="#475569" Margin="12,0,6,0" />
                    <TextBox x:Name="TxtPassword" Grid.Column="3" Padding="6,4" FontSize="12"
                             ToolTip="可选 ZIP/7z/RAR/PDF/Office 打开密码" />
                </Grid>

                <WrapPanel>
                    <CheckBox x:Name="ChkEnableOcr" Content="启用图片与内嵌图 OCR" VerticalAlignment="Center" Margin="0,0,14,2" FontSize="12" />
                    <CheckBox x:Name="ChkSkipTemp" Content="忽略 ~$ 临时文件与系统目录" VerticalAlignment="Center" Margin="0,0,14,2" FontSize="12" />
                    <CheckBox x:Name="ChkIdleIndex" Content="闲时自动增量索引 (连续3分钟无操作)" VerticalAlignment="Center" Margin="0,0,14,2" FontSize="12" />
                    <CheckBox x:Name="ChkLowResourceMode" Content="后台低占用模式（单路空闲优先级，不卡顿前台）" VerticalAlignment="Center" FontSize="12" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="立即增量索引" Style="{StaticResource PrimaryButton}" Click="BtnSaveAndIncremental_Click" Margin="0,0,8,0" />
                <Button Content="全量重建索引" Click="BtnSaveAndRebuild_Click" Margin="0,0,8,0" />
                <Button Content="低占用重建索引" Click="BtnSaveAndLowRebuild_Click"
                        ToolTip="清空文档与倒排索引（保留图片 OCR 缓存）并在单路空闲优先级下低占用重建" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="保存设置" Click="BtnSave_Click" Width="88" Margin="0,0,8,0" IsDefault="True" />
                <Button Content="取消" Width="76" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
