<Window x:Class="DocSentinel.UI.Dialogs.ColumnChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择显示列与顺序"
        Width="390" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="勾选需要显示的文件列表字段，并可调整列排列顺序（至少保留一列）："
                   TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ColumnsList" Grid.Column="0" BorderBrush="#CBD5E1" Background="#FFFFFF">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}"
                                  Content="{Binding Header}"
                                  FontSize="12.5" Margin="4,3" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                <Button Content="上移 ↑" Click="BtnMoveUp_Click" Width="82" Margin="0,0,0,6" />
                <Button Content="下移 ↓" Click="BtnMoveDown_Click" Width="82" Margin="0,0,0,12" />
                <Button Content="全选" Click="BtnSelectAll_Click" Width="82" Margin="0,0,0,6" />
                <Button Content="恢复默认" Click="BtnReset_Click" Width="82" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="BtnOk_Click" Width="84" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="取消" Width="84" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
